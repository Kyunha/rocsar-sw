# buf generate writes these. The Python and C outputs ARE committed -- the GS
# must install on a laptop with no toolchain, and the Arduino build compiles by
# folder proximity so firmware/*.c must exist on disk.
/api/rocsar/v1/*.pb.go

# Vendored upstream, pinned, not ours to reformat.
third_party/

# Build output
/obc
/gs_cli
/bin/
*.test
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Wails generates these at build time (wails build / wails dev), like the Go
# protobuf bindings above. A bare `npm run build` does not regenerate them, so
# the frontend builds only through wails -- which is the only supported path.
cmd/gs/build/bin/
cmd/gs/frontend/dist/*
!cmd/gs/frontend/dist/.gitkeep
cmd/gs/frontend/node_modules/
cmd/gs/frontend/wailsjs/

# Per-machine config overrides rocsar.toml
rocsar.local.toml

# Runtime data
/data/

# Map tile data: large binary blob, not code. The frontend copy is embedded by
# Wails at build time; the root copy is a duplicate for offline use.
/pmtiles/
cmd/gs/frontend/pmtiles/

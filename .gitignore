# buf generate writes these. The Python and C outputs ARE committed -- the GS
# must install on a laptop with no toolchain, and the Arduino build compiles by
# folder proximity so firmware/*.c must exist on disk.
/api/rocsar/v1/*.pb.go

# Vendored upstream, pinned, not ours to reformat.
third_party/

# Build output
/obc
/gs_cli
/bin/
*.test
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Wails build output. 6f25e21 stopped ignoring cmd/gs/build/ in the same commit
# that added a 12.7 MB compiled cmd/gs/build/bin/gs to git, so the directory was
# neither ignored nor wanted -- it is regenerated by `wails build` and by
# scripts/build.sh, and a checked-in binary goes stale the moment the source does.
# Restore the rule rather than relying on nobody running wails again.
cmd/gs/build/bin/
cmd/gs/build/*.png

# The prebuilt console binary at the repo root is the same class of thing and was
# committed alongside it. Built by scripts/build.sh; install it on the OBC.
rocsar-gs

# Frontend build output. `npm run build` (tsc + vite) regenerates dist/ from
# src/ and public/; the committed basemap assets under public/ (geojson/ from
# scripts/fetch-basemap.py, relief/ from scripts/fetch-relief) are copied in,
# not generated here.
cmd/gs/frontend/dist/*
!cmd/gs/frontend/dist/.gitkeep

# Leaflet was replaced by maplibre-gl for the basemap; these were its vendored
# bundle and marker icons, referenced by the pre-maplibre map.ts and by nothing
# now. Kept out of the tree rather than deleted-and-forgotten, so a revert to
# Leaflet does not have to re-vendor 390 KB.
# cmd/gs/frontend/src/leaflet.*
cmd/gs/frontend/node_modules/

# Per-machine config overrides rocsar.toml
rocsar.local.toml

# Runtime data
/data/

# Legacy pmtiles basemap, replaced by the committed Natural Earth GeoJSON in
# cmd/gs/frontend/public/geojson (see scripts/fetch-basemap.py). Ignored so any
# local copy left behind never lands in a commit.
/pmtiles/
cmd/gs/frontend/pmtiles/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
